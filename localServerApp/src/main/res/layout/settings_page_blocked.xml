<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Wine Red Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorErrorContainer"
            app:strokeColor="?attr/colorError"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="26sp"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hidden Content"
                        style="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="?attr/colorOnErrorContainer"
                        android:textStyle="bold"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filter out unwanted content. Videos matching these keywords, or from these channels, will be completely hidden."
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnErrorContainer"
                        android:alpha="0.85"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Block Custom Keyword -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block Custom Keyword"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_custom_blocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. ASMR, unboxing, drama"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_add_custom_blocked"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:text="block"
                android:backgroundTint="?attr/colorError"
                android:textColor="?attr/colorOnError"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <!-- Quick Add Block Suggestions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Add Suggestions"
            style="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_blocked_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp"
            android:layout_marginBottom="20dp"/>

        <!-- Currently Blocked Keywords Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blocked Keywords"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorError"
            android:layout_marginBottom="6dp"/>

        <!-- Currently Blocked Keywords Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_blocked_keywords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"/>

                <TextView
                    android:id="@+id/tv_blocked_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No keywords blocked."
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center"
                    android:padding="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Blocked Channels Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blocked Channels"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorError"
            android:layout_marginBottom="6dp"/>

        <!-- Block Channel Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_custom_blocked_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter channel name..."
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_add_blocked_channel"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:text="block"
                android:backgroundTint="?attr/colorError"
                android:textColor="?attr/colorOnError"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <!-- Blocked Channels Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_blocked_channels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"/>

                <TextView
                    android:id="@+id/tv_blocked_channels_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No channels blocked."
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center"
                    android:padding="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Browse Categories to Block Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Browse Categories to Block"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="12dp"/>

        <!-- Category Container: Expandable Cards will be generated inside this LinearLayout -->
        <LinearLayout
            android:id="@+id/layout_blocked_categories_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
