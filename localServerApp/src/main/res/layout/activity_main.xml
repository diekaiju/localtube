<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <!-- Title and Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/dialog_holo_dark_frame">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LocalTube"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Stopped"
            android:textColor="#FF5555"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/text_ip_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP Address: Not Available"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Controls Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Server"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_open_browser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Browser"
            android:enabled="false" />
    </LinearLayout>

    <!-- URLs Card -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Access Endpoints:"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/text_urls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server is not running."
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:background="#222222" />

    <!-- Log Console -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server Logs:"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0A0A"
        android:padding="8dp">

        <TextView
            android:id="@+id/text_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="System logs will appear here...\n"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:typeface="monospace"/>
    </ScrollView>

</LinearLayout>
