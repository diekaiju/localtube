<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#1E1E1E"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LocalTube Server Console"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Server Status & Controls Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="16dp"
                app:strokeColor="#2C2C2C"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Status Indicator Row -->
                    <LinearLayout
                        android:id="@+id/layout_status_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/status_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔴"
                            android:textSize="28sp"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Status: Stopped"
                                android:textColor="#E53935"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/text_ip_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IP Address: Not Available"
                                android:textColor="#BBBBBB"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerColor="#2C2C2C"
                        android:layout_marginBottom="16dp"/>

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_toggle"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1.2"
                            android:text="Start Server"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#4CAF50"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_marginEnd="8dp"
                            app:cornerRadius="8dp"/>

                        <Button
                            android:id="@+id/btn_open_browser"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Open Link"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#2196F3"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:enabled="false"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_settings"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="⚙️ Configure Feed Filters"
                        android:textColor="#4CAF50"
                        app:strokeColor="#4CAF50"
                        android:layout_marginTop="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Play Lock Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_play_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="16dp"
                app:strokeColor="#2C2C2C"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Casting &amp; Concurrency Lock"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/text_lock_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: Unlocked / Idle"
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp"
                        android:lineSpacingMultiplier="1.2"/>

                    <Button
                        android:id="@+id/btn_force_release"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🔓 Force Release Lock"
                        android:textColor="#E53935"
                        app:strokeColor="#E53935"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Launch Dedicated Remote Controller Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_remote_launcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="16dp"
                app:strokeColor="#7C3AED"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wireless TV Remote"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Control TV playback, move pointer and scroll content using a fullscreen touchpad layout."
                        android:textColor="#BBBBBB"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp"
                        android:lineSpacingMultiplier="1.2"/>

                    <Button
                        android:id="@+id/btn_launch_remote"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="📱 Open Remote Control"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#7C3AED"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Endpoints Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Access Endpoints"
                android:textColor="#888888"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="16dp"
                app:strokeColor="#2C2C2C"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp">

                <TextView
                    android:id="@+id/text_urls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Server is not running."
                    android:textColor="#AAAAAA"
                    android:textSize="14sp"
                    android:padding="16dp"
                    android:lineSpacingMultiplier="1.2"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Logs Card -->
            <TextView
                android:id="@+id/text_logs_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Console logs (tap to collapse)"
                android:textColor="#888888"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_logs"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:cardBackgroundColor="#0F172A"
                app:cardCornerRadius="16dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <ScrollView
                    android:id="@+id/scroll_logs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/text_logs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="System logs will appear here...\n"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:typeface="monospace"
                        android:lineSpacingMultiplier="1.1"/>
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
