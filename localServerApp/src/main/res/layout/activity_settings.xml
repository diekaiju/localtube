<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Custom Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#1E1E1E">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="?android:attr/homeAsUpIndicator"
            android:tint="#FFFFFF"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go Back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personalized Preferences"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        app:tabTextColor="#888888"
        app:tabSelectedTextColor="#4CAF50"
        app:tabIndicatorColor="#4CAF50"
        app:tabIndicatorHeight="3dp"
        app:tabGravity="fill"
        app:tabMode="fixed"/>

    <!-- Content Scroller -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- ============================================== -->
            <!-- INTERESTS TAB CONTENT                          -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/layout_interests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Forest Green Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#132D1B"
                    app:strokeColor="#2E7D32"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡"
                            android:textSize="28sp"
                            android:layout_marginEnd="16dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your Interests"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LocalTube builds your home feed by searching for your followed interest keywords. Select from the categories or add custom topics below."
                                android:textColor="#BBBBBB"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Currently Following Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Currently Following"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <!-- Currently Following Container -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A1A"
                    app:strokeColor="#2C2C2C"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cg_preferred_topics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp"/>

                        <TextView
                            android:id="@+id/tv_preferred_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No interests followed yet. Select topics from below or search/type custom ones."
                            android:textColor="#666666"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:padding="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Custom Interest Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Custom Interest"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <EditText
                        android:id="@+id/et_custom_interest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="e.g. Astrophysics, Jazz, Indie Games"
                        android:textColorHint="#555555"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:padding="12dp"
                        android:background="#1A1A1A"
                        android:inputType="text"/>

                    <Button
                        android:id="@+id/btn_add_custom_interest"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="+ Add"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#4CAF50"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Browse Categories Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Browse Categories"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Category Container: Expandable Cards will be generated inside this LinearLayout -->
                <LinearLayout
                    android:id="@+id/layout_categories_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

            <!-- ============================================== -->
            <!-- BLOCKED TAB CONTENT                            -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/layout_blocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Wine Red Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#2D1313"
                    app:strokeColor="#C62828"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️"
                            android:textSize="28sp"
                            android:layout_marginEnd="16dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hidden Content"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Filter out unwanted content. Videos matching these keywords, or from these channels, will be completely hidden from all feeds."
                                android:textColor="#BBBBBB"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Block Custom Keyword -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Block Custom Keyword"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/et_custom_blocked"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="e.g. clickbait, trailer, drama"
                        android:textColorHint="#555555"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:padding="12dp"
                        android:background="#1A1A1A"
                        android:inputType="text"/>

                    <Button
                        android:id="@+id/btn_add_custom_blocked"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Block"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#C62828"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Quick Add Block Suggestions -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quick Add Suggestions"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_blocked_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    android:layout_marginBottom="20dp"/>

                <!-- Currently Blocked Keywords Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blocked Keywords"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <!-- Currently Blocked Keywords Container -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A1A"
                    app:strokeColor="#2C2C2C"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cg_blocked_keywords"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp"/>

                        <TextView
                            android:id="@+id/tv_blocked_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No keywords blocked."
                            android:textColor="#666666"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:padding="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Blocked Channels Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blocked Channels"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <!-- Block Channel Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/et_custom_blocked_channel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Enter channel name..."
                        android:textColorHint="#555555"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:padding="12dp"
                        android:background="#1A1A1A"
                        android:inputType="text"/>

                    <Button
                        android:id="@+id/btn_add_blocked_channel"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Block"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#C62828"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Blocked Channels Container -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A1A"
                    app:strokeColor="#2C2C2C"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cg_blocked_channels"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp"/>

                        <TextView
                            android:id="@+id/tv_blocked_channels_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No channels blocked."
                            android:textColor="#666666"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:padding="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Browse Categories to Block Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Browse Categories to Block"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Category Container: Expandable Cards will be generated inside this LinearLayout -->
                <LinearLayout
                    android:id="@+id/layout_blocked_categories_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp"/>

                <!-- General Video Toggles Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="General Video Filters"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <!-- General Video Toggles Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A1A"
                    app:strokeColor="#2C2C2C"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Video Quality Selector -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Preferred Video Quality"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp"/>

                        <Spinner
                            android:id="@+id/spinner_video_quality"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#FFFFFF"
                            android:layout_marginBottom="16dp"/>


                        <!-- Hide Watched -->
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_hide_watched"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hide Watched Videos (10%+ watched)"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:theme="@style/Theme.LocalMediaServer"
                            android:layout_marginBottom="16dp"/>

                        <!-- Hide Shorts -->
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_hide_shorts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hide Shorts (duration ≤ 120s)"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:theme="@style/Theme.LocalMediaServer"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ============================================== -->
            <!-- BACKUP TAB CONTENT                             -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/layout_backup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Backup Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#13232D"
                    app:strokeColor="#2E6B7D"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💾"
                            android:textSize="28sp"
                            android:layout_marginEnd="16dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Backup &amp; Restore"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Export your watch history, subscriptions, bookmarked playlists, and settings to a JSON file, or import them back to restore your data."
                                android:textColor="#BBBBBB"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Export Button -->
                <Button
                    android:id="@+id/btn_export_db"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Export Database (JSON)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#007ACC"
                    android:layout_marginBottom="16dp"
                    android:padding="12dp"/>

                <!-- Import Button -->
                <Button
                    android:id="@+id/btn_import_db"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Import Database (JSON)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2E7D32"
                    android:padding="12dp"/>

            </LinearLayout>

        </FrameLayout>
    </ScrollView>

</LinearLayout>
