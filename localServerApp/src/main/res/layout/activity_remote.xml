<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?attr/colorSurfaceContainer">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="?android:attr/homeAsUpIndicator"
            android:contentDescription="Back to main console"
            android:tint="?attr/colorOnSurface"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wireless TV Remote"
            style="@style/TextAppearance.Material3.TitleLarge"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Touchpad Surface Card (takes most vertical space) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.6"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:strokeColor="?attr/colorSecondary"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="20dp"
            android:layout_marginBottom="16dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/touchpad_surface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/touchpad_background"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="📱 Touchpad\nDrag to move pointer • Tap to click"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:alpha="0.8" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Touchpad Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4"
            android:layout_marginBottom="12dp">
            <Button
                android:id="@+id/remote_click"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1.5"
                android:text="👆 Click"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"
                android:padding="0dp"
                app:cornerRadius="12dp"/>
            <Button
                android:id="@+id/remote_scroll_up"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="0.8"
                android:text="⇧"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"
                android:padding="0dp"
                app:cornerRadius="12dp"/>
            <Button
                android:id="@+id/remote_scroll_down"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="0.8"
                android:text="⇩"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"
                android:padding="0dp"
                app:cornerRadius="12dp"/>
            <Button
                android:id="@+id/remote_back"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="0.9"
                android:text="⤶"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="0dp"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <!-- Media Controls Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Media Playback"
                    style="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="12dp"
                    android:layout_gravity="center_horizontal"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:weightSum="3">
                    <Button
                        android:id="@+id/remote_rewind"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="⏪ -10s"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp"
                        app:cornerRadius="12dp"/>
                    <Button
                        android:id="@+id/remote_play_pause"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="▶▮▮"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp"
                        android:layout_marginStart="4dp"
                        app:cornerRadius="12dp"/>
                    <Button
                        android:id="@+id/remote_forward"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="⏩ +10s"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp"
                        app:cornerRadius="12dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</LinearLayout>
